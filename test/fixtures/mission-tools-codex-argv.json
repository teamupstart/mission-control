[
  "--sandbox",
  "workspace-write",
  "--ask-for-approval",
  "on-request",
  "-c",
  "mcp_servers.mission-control.command=\"<NODE>\"",
  "-c",
  "mcp_servers.mission-control.args=[\"<STATE_HOME>/server.mjs\"]",
  "-c",
  "mcp_servers.mission-control.env={\"PATH\"=\"<PATH>\",\"MISSION_HOME\"=\"<AGENT_HOME>\",\"MISSION_PORT\"=\"7317\",\"MISSION_SCOUT_SUBMISSION_CREDENTIAL_FILE\"=\"<CREDENTIAL_FILE>\",\"MISSION_PRODUCT_ISSUE_CLIENT\"=\"browser\"}",
  "-c",
  "hooks.SessionStart=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'SessionStart'\"}]}]",
  "-c",
  "hooks.UserPromptSubmit=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'UserPromptSubmit'\"}]}]",
  "-c",
  "hooks.PreToolUse=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'PreToolUse'\"}]}]",
  "-c",
  "hooks.PostToolUse=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'PostToolUse'\"}]}]",
  "-c",
  "hooks.PermissionRequest=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'PermissionRequest'\"}]}]",
  "-c",
  "hooks.Stop=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'Stop'\"}]}]",
  "-c",
  "hooks.PreCompact=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'PreCompact'\"}]}]",
  "-c",
  "hooks.PostCompact=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'PostCompact'\"}]}]",
  "-c",
  "hooks.SubagentStart=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'SubagentStart'\"}]}]",
  "-c",
  "hooks.SubagentStop=[{hooks=[{type=\"command\",command=\"'<NODE>' '<STATE_HOME>/codex-hook.mjs' 'SubagentStop'\"}]}]",
  "--dangerously-bypass-hook-trust"
]
