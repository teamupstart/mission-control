{
  "name": "mission-control",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "author": "Mission Control",
  "description": "Local, auto-refreshing control plane for Claude Code / Codex / Pi sessions across terminal panes",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mission-control": "src/server/index.ts"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run build:keep-awake-native && tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:electron": "npm run build:main && concurrently -n esbuild,electron -c yellow,green \"npm run build:main -- --watch\" \"MISSION_DEV_SERVER_URL=http://localhost:5173 electronmon .\"",
    "dev:foreman": "tsx watch src/server/foreman/worker.ts",
    "dev:desktop": "concurrently -n server,web,shell -c blue,magenta,green \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:start": "concurrently -n server,web,shell,foreman -c blue,magenta,green,cyan \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:electron\" \"npm:dev:foreman\"",
    "build": "npm run build:keep-awake-native && npm run build:web && npm run build:server && npm run build:main && npm run build:mcp && npm run build:hook && npm run build:codex-hook",
    "build:keep-awake-native": "node scripts/build-keep-awake-native.mjs",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --main-fields=module,main --alias:@shared=./src/shared --outfile=dist/server/index.mjs",
    "build:main": "esbuild src/main/index.ts src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --main-fields=module,main --alias:@shared=./src/shared --outdir=dist --outbase=src --out-extension:.js=.cjs",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --target=node22 --main-fields=module,main --alias:@shared=./src/shared --outfile=dist/mcp/server.mjs",
    "smoke": "node scripts/smoke-bundles.mjs",
    "verify:keep-awake-native": "node scripts/probe-keep-awake-native.mjs",
    "demo": "node scripts/demo/launch.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "build:hook": "esbuild hooks/harness-hook.mjs --bundle --platform=node --format=esm --target=node22 --outfile=dist/satellites/hook.mjs",
    "build:codex-hook": "esbuild hooks/codex-hook.mjs --bundle --platform=node --format=esm --target=node22 --outfile=dist/satellites/codex-hook.mjs",
    "package": "npm run build && electron-builder --mac",
    "start": "npm run build:keep-awake-native && tsx src/server/index.ts",
    "foreman": "tsx src/server/foreman/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src hooks test scripts e2e integrations",
    "pretest": "node scripts/ensure-electron-framework.mjs && node scripts/ensure-electron-runtime.mjs",
    "test": "node --test --test-concurrency=${MISSION_TEST_CONCURRENCY:-6} --import ./test/setup-state.mjs --import tsx 'test/**/*.test.ts'",
    "posttest": "npm run test:workflow-evidence",
    "test:workflow-evidence": "node --test --import ./test/setup-state.mjs --import tsx test/workflow-image-evidence.test.ts test/workflow-test-evidence-audit.test.ts",
    "pretest:electron": "node scripts/ensure-electron-framework.mjs && node scripts/ensure-electron-runtime.mjs",
    "test:electron": "node --test --import ./test/setup-state.mjs --import tsx 'test/*-electron.test.ts'",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "init": "node scripts/init.mjs",
    "personas": "tsx scripts/builtin-personas.ts",
    "session-actions": "tsx scripts/builtin-session-actions.ts",
    "session": "node scripts/new-session.mjs",
    "worktree-setup": "node scripts/worktree-setup.mjs",
    "setup": "npm install && npm run build && npm run install-hooks",
    "install-hooks": "tsx hooks/install.mjs",
    "install-statusline": "tsx hooks/install.mjs --statusline",
    "install-telemetry": "tsx hooks/install.mjs --telemetry",
    "install-service": "node scripts/install-service.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@codemirror/language-data": "^6.5.2",
    "@hono/node-server": "^1.13.7",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.149.0",
    "@xyflow/react": "^12.11.2",
    "codemirror": "^6.0.2",
    "cron-parser": "5.6.2",
    "driver.js": "1.8.0",
    "hono": "^4.6.14",
    "jsonc-parser": "^3.3.1",
    "mermaid": "11.16.1",
    "parse5": "^8.0.1",
    "react": "^19.0.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "node-gyp": "^12.4.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    }
  },
  "electronmon": {
    "patterns": [
      "!**/*",
      "dist/main/**",
      "dist/preload/**"
    ]
  }
}
