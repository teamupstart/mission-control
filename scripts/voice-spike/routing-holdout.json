    "Iris": "QA: writes and runs the test suites",
    "Felix": "security: reviews auth, tokens and secrets",
    "Nora": "docs: writes guides and release notes",
    "Owen": "releases: cuts and ships releases",
    "Ruby": "database: schema, migrations and queries",
    "Hugo": "product: priorities and specs",
    "Clara": "design: mockups and UX review",
    "Ezra": "infrastructure: servers, deploys and monitoring",
    "Leo": "mobile: the iOS and Android apps",
    "Mara": "analytics: dashboards and weekly numbers"
  },
  "cards": {
    "test-runner": {
      "prompt": "Which test runner should the new package use?",
      "options": [
        {
          "label": "Vitest",
          "detail": "recommended; fast and Vite-native"
        },
        {
          "label": "Jest",
          "detail": "widely used, slower"
        },
        {
          "label": "node:test",
          "detail": "built into Node, no dependency"
        }
      ]
    },
    "deploy": {
      "prompt": "Deploy the fix now or wait for the morning window?",
      "options": [
        {
          "label": "Deploy now",
          "detail": "ship immediately"
        },
        {
          "label": "Wait for the morning window",
          "detail": "recommended; lower risk"
        }
      ]
    },
    "cache": {
      "prompt": "Where should the session cache live?",
      "options": [
        {
          "label": "Redis",
          "detail": "recommended; a shared server"
        },
        {
          "label": "In-memory",
          "detail": "per process, lost on restart"
        },
        {
          "label": "SQLite",
          "detail": "a file on disk"
        }
      ]
    }
  },
